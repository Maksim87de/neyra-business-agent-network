# Client-local runtime values. This file is created with mode 0600 and never committed.
CLIENT_ID=REPLACE_WITH_CLIENT_SLUG
# The client chooses and owns the model provider, account, limits and billing.
# Select one auth mode: native (Neyra OAuth), env (client-local API key), custom.
# Do not paste credentials through chat or commit this file.
NEYRA_PROVIDER=REPLACE_WITH_PROVIDER
NEYRA_MODEL=REPLACE_WITH_MODEL
NEYRA_PROVIDER_AUTH_MODE=REPLACE_WITH_NATIVE_ENV_OR_CUSTOM
# Required only for auth mode "env": name of the existing key variable, not its value.
# Example: KIMI_API_KEY, GOOGLE_API_KEY or OPENROUTER_API_KEY.
NEYRA_PROVIDER_KEY_ENV=
# Optional channel. Keep empty until the provider/model smoke has passed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
