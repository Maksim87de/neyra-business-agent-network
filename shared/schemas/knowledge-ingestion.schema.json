{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neyra knowledge ingestion record",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "client_id", "source", "classification", "status", "created_at"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "client_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "enum": ["public", "internal", "confidential"]},
    "status": {"type": "string", "enum": ["received", "indexed", "rejected", "deleted"]},
    "created_at": {"type": "string", "format": "date-time"},
    "chunk_count": {"type": "integer", "minimum": 0},
    "index_version": {"type": "string"},
    "deletion_requested_at": {"type": "string", "format": "date-time"}
  }
}
