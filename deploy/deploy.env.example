# Host-only deployment settings. Copy to /etc/neyra-client/deploy.env with mode 0600.
# Pin an approved private GHCR image tag or immutable digest from a verified release.
NEYRA_CLIENT_IMAGE=REPLACE_WITH_APPROVED_IMAGE
# Must match the immutable digest recorded in release/release-manifest.json.
NEYRA_COMPOSE_PROJECT=neyra-client
NEYRA_HOME=/opt/neyra-client/home
NEYRA_UID=10000
NEYRA_GID=10000
NEYRA_DISPLAY_LANGUAGE=ru
NEYRA_TIMEZONE=Asia/Novosibirsk
NEYRA_PIDS_LIMIT=512
NEYRA_MEM_LIMIT=4g
