# Host-only deployment settings. Copy to /etc/neyra-client/deploy.env with mode 0600.
# Public test release. Production use should pin the immutable digest from its
# GitHub release note instead of this mutable tag.
NEYRA_CLIENT_IMAGE=ghcr.io/maksim87de/neyra-business-agent-network:v0.1.0-test
# Public fallback for hosts without GHCR access. The installer verifies and loads
# this release asset before starting the same image tag.
NEYRA_CLIENT_IMAGE_TAR_URL=https://github.com/Maksim87de/neyra-business-agent-network/releases/download/v0.1.0-test/neyra-business-agent-network-v0.1.0-test.tar.gz
NEYRA_COMPOSE_PROJECT=neyra-client
NEYRA_HOME=/opt/neyra-client/home
NEYRA_UID=10000
NEYRA_GID=10000
NEYRA_DISPLAY_LANGUAGE=ru
NEYRA_TIMEZONE=Asia/Novosibirsk
NEYRA_PIDS_LIMIT=512
NEYRA_MEM_LIMIT=4g
