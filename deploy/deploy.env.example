# Host-only deployment settings. Copy to /etc/neyra-client/deploy.env with mode 0600.
# Public installation release. Production use should pin the immutable digest
# published in its release note instead of this mutable tag.
NEYRA_CLIENT_IMAGE=ghcr.io/maksim87de/neyra-business-agent-network:v0.1.0
# Public fallback when the host cannot authenticate to the private GHCR package.
# The installer verifies and loads this release asset before starting the same tag.
NEYRA_CLIENT_IMAGE_TAR_URL=https://github.com/Maksim87de/neyra-business-agent-network/releases/download/v0.1.0/neyra-business-agent-network-v0.1.0.tar.gz
NEYRA_COMPOSE_PROJECT=neyra-client
NEYRA_HOME=/opt/neyra-client/home
NEYRA_UID=10000
NEYRA_GID=10000
NEYRA_DISPLAY_LANGUAGE=ru
NEYRA_TIMEZONE=Asia/Novosibirsk
NEYRA_PIDS_LIMIT=512
NEYRA_MEM_LIMIT=4g
